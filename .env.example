# The application runs end-to-end without credentials when DEMO_MODE=true.
DEMO_MODE=true
APP_NAME=Following blowing
COMPETITION_MODE=true

MULTIMODAL_PROVIDER=demo
MULTIMODAL_API_KEY=
MULTIMODAL_BASE_URL=
# Legacy fallback for MODEL_MAIN; new deployments should use the role routes below.
MULTIMODAL_MODEL=
MULTIMODAL_TIMEOUT=120

MODEL_FAST=gpt-5.6-luna
MODEL_MAIN=gpt-5.6-terra

IMAGE_PROVIDER=demo
IMAGE_API_KEY=
IMAGE_BASE_URL=
IMAGE_MODEL=gpt-image-2
IMAGE_TIMEOUT=180
# Readiness is derived from both opt-in image smoke markers. This optional
# override can only disable an accepted marker; it cannot promote readiness.
# IMAGE_PROVIDER_VERIFIED=false
MULTI_REFERENCE_IMAGE_EDIT=false
MULTI_REFERENCE_IMAGE_EDIT_VERIFIED=false

SEARCH_PROVIDER=demo
SEARCH_API_KEY=
SEARCH_BASE_URL=
SEARCH_MODEL=
SEARCH_TIMEOUT=120
# Set true only after a separate web_search capability test succeeds.
SEARCH_PROVIDER_VERIFIED=false

# Optional shared fallback used only by adapters explicitly set to `openai`.
OPENAI_API_KEY=

MAX_PROVIDER_RETRIES=2
MAX_GUARDIAN_RETRIES=2
MAX_IMAGE_GENERATIONS_PER_RUN=3
MAX_AI_SUPPLEMENT_RETRIES=3
